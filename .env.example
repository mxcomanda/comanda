# Copia a .env.local (nunca se sube a Git). En Vercel se ponen en Settings → Environment Variables.
# Base de datos Postgres (elige UNA):
#  - Vercel Postgres: créala en Vercel → Storage → Create Database → Postgres, conecta el proyecto y Vercel rellena POSTGRES_URL automáticamente.
#  - Neon (gratis) o Supabase (gratis): pega aquí su connection string.
POSTGRES_URL="postgres://usuario:password@host:5432/comanda"
# Secreto para firmar la sesión del personal (cámbialo por uno largo y aleatorio):
STAFF_SESSION_SECRET="cambia-esto-por-una-frase-larga-aleatoria"
# Contacto de la página raíz (ya puesto):
